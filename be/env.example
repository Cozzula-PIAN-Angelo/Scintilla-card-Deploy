# Variabili d'ambiente del backend. In locale sono TUTTE facoltative: il profilo
# "local" (attivo di default) ha valori di sviluppo. Servono solo per cambiarli.
# Spring non legge .env da solo: esporta le variabili nella shell
# o impostale nella run configuration dell'IDE.

# Database
DB_URL=jdbc:postgresql://localhost:5432/naso-commers
DB_USERNAME=postgres
DB_PASSWORD=1234

# JWT (almeno 32 caratteri). Su Render lo genera il blueprint.
JWT_SECRET=sostituisci-con-una-stringa-casuale-di-almeno-32-caratteri
# Durata del token in millisecondi (7 giorni)
JWT_EXPIRATION=604800000

# Admin creato dal seeder (in locale: admin@ecommerce.local / admin1234)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiami-subito

# Origini ammesse dal CORS, separate da virgola
ALLOWED_ORIGIN=http://localhost:5173

# API Pokémon TCG (facoltativa: lasciala vuota per usare l'API senza chiave)
POKEMONTCG_API_KEY=

# Set importati da pokemontcg.io al primo avvio, se il catalogo è vuoto (vuoto = nessuno)
SEED_SET=base1

# Solo su Render: SPRING_PROFILES_ACTIVE=prod e DATABASE_URL (dal database)

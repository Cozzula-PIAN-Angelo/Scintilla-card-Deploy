# In locale non serve: senza VITE_API_URL si usa http://localhost:3001.
# Copia in .env.local solo se il backend gira altrove.
#
# Su Render: indirizzo completo del backend, senza / finale, es.
#   VITE_API_URL=https://scintilla-be.onrender.com
# Vite la legge al momento della BUILD: cambiarla richiede un nuovo deploy.
VITE_API_URL=http://localhost:3001
